<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hik_livox_system</name>
  <version>0.1.0</version>
  <description>Unified bringup for Hikvision camera, Livox Mid-70, armor detection and projection.</description>
  <maintainer email="szx@example.com">szx</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>livox_interfaces</depend>
  <depend>vision_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>dist_msg</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>hik_camera</exec_depend>
  <exec_depend>livox_ros2_driver</exec_depend>
  <exec_depend>livox_pcd_projection</exec_depend>
  <exec_depend>ros2_armor_detector</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
